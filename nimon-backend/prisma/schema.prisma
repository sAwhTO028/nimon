generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PublishState {
  draft
  reading_only_published
  full_learn_published
}

enum ModuleTaskStatus {
  not_started
  in_progress
  completed
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Nullable for legacy/dev rows (e.g. dev owner without email). Email/password users set this.
  email String? @unique

  /// bcrypt hash; null for rows created before auth or dev-only users without password login
  passwordHash String?

  storyDrafts            StoryDraft[]
  publishedMonos         PublishedMono[]
  monoBookmarks          MonoBookmark[]
  monoReactions          MonoReaction[]
  following              UserFollow[]            @relation("followingEdges")
  followers              UserFollow[]            @relation("followerEdges")
  profile                UserProfile?
  preferences            UserPreference?
  refreshTokens          RefreshToken[]
  creatorMonoCollections CreatorMonoCollection[]

  @@map("users")
}

model UserPreference {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// UI language preference. Null means "system default".
  appLocale String?

  /// Community / content region locale. Null means backend default.
  contentLocale String?

  /// Target language being learned. Null means backend default.
  learningLanguage String?

  /// Theme mode. Null means "system default".
  themeMode String?

  /// Reader text size: small | standard | large. Null means standard.
  readingTextSize String?

  /// When false, hide per-sentence explanation lines in the mono reader. Null means true.
  showExplanations Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model UserFollow {
  followerId String @db.Uuid
  follower   User   @relation("followingEdges", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String @db.Uuid
  following   User   @relation("followerEdges", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("user_follows")
}

model UserProfile {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName   String?
  handle        String? @unique
  avatarUrl     String?
  coverImageUrl String?
  bio           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex of the opaque refresh token (never store plaintext token)
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model StoryDraft {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schemaVersion Int @default(1)

  /// optimistic concurrency (ETag-style) can be built on top later
  version Int @default(1)

  publishState PublishState @default(draft)

  publishedMonoId String?        @db.Uuid
  publishedMono   PublishedMono? @relation(fields: [publishedMonoId], references: [id], onDelete: SetNull)

  readingOnlyPublishedAt DateTime?
  fullLearnPublishedAt   DateTime?

  // "basics" in the contract (V1 simple; avoid over-normalizing)
  title                 String  @default("")
  category              String  @default("")
  level                 String  @default("")
  description           String  @default("")
  promptSourceNote      String  @default("")
  targetDurationBandKey String?
  coverImageUrl         String?

  /// M22D-1: community / audience language (`en` | `my` | `ja`). Null → publish uses user prefs.
  contentLocale String?

  /// M22D-1: target language being learned (V1: `ja`). Null → publish uses user prefs.
  learningLanguage String?

  // moduleWorkflowStatuses: Map<learnModuleId, ModuleTaskStatus> (stored as JSON for V1)
  moduleWorkflowStatuses Json @default("{}")

  /// True when publishState is not `draft` and working copy may differ from last published snapshot.
  /// New rows default false; migration sets true for existing non-draft rows (conservative).
  hasUnpublishedCoreChanges Boolean @default(false)

  sentences      DraftSentence[]
  vocabEntries   DraftVocabEntry[]
  grammarEntries DraftGrammarEntry[]
  quizEntries    DraftQuizEntry[]
  audios         DraftAudio[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, publishState])
  @@map("story_drafts")
}

model DraftSentence {
  id        String     @id @default(uuid()) @db.Uuid
  draftId   String     @db.Uuid
  draft     StoryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  order Int

  /// Sentence content shape is evolving; keep JSON for V1.
  content Json

  @@unique([draftId, order])
  @@index([draftId])
  @@map("draft_sentences")
}

model DraftVocabEntry {
  id        String     @id @default(uuid()) @db.Uuid
  draftId   String     @db.Uuid
  draft     StoryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  order   Int
  content Json

  @@unique([draftId, order])
  @@index([draftId])
  @@map("draft_vocab_entries")
}

model DraftGrammarEntry {
  id        String     @id @default(uuid()) @db.Uuid
  draftId   String     @db.Uuid
  draft     StoryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  order   Int
  content Json

  @@unique([draftId, order])
  @@index([draftId])
  @@map("draft_grammar_entries")
}

model DraftQuizEntry {
  id        String     @id @default(uuid()) @db.Uuid
  draftId   String     @db.Uuid
  draft     StoryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  order   Int
  content Json

  @@unique([draftId, order])
  @@index([draftId])
  @@map("draft_quiz_entries")
}

model DraftAudio {
  id        String     @id @default(uuid()) @db.Uuid
  draftId   String     @db.Uuid
  draft     StoryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// for V1 we only need a single "storyAudio" blob; JSON keeps it flexible
  kind    String @default("storyAudio")
  content Json

  @@index([draftId])
  @@map("draft_audio")
}

model PublishedMono {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // V1 simple fields; expand later
  title       String @default("")
  category    String @default("")
  level       String @default("")
  description String @default("")

  /// M11e: community/content region for feed defaults (en/my/ja). Null = legacy/untagged.
  contentLocale String?

  /// M11e: target learning language (V1: ja). Null = legacy/untagged.
  learningLanguage String?

  content Json @default("{}")

  /// M22B: denormalized feed summary (catalog list avoids selecting `content` JSONB).
  coverImageUrl String?
  publishKind   String?
  hasAudio      Boolean @default(false)
  sentenceCount Int?
  vocabCount    Int?
  grammarCount  Int?
  quizCount     Int?

  /// P1 Trash: when set, mono is hidden from catalog/feed and default owner published list.
  trashedAt DateTime?

  drafts                     StoryDraft[]
  monoBookmarks              MonoBookmark[]
  monoReactions              MonoReaction[]
  creatorMonoCollectionItems CreatorMonoCollectionItem[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, trashedAt])
  @@index([contentLocale, learningLanguage, updatedAt])
  @@map("published_monos")
}

model MonoBookmark {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  publishedMonoId String        @db.Uuid
  publishedMono   PublishedMono @relation(fields: [publishedMonoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, publishedMonoId])
  @@index([userId, createdAt])
  @@index([publishedMonoId])
  @@map("mono_bookmarks")
}

model MonoReaction {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  publishedMonoId String        @db.Uuid
  publishedMono   PublishedMono @relation(fields: [publishedMonoId], references: [id], onDelete: Cascade)

  kind      String   @default("heart")
  createdAt DateTime @default(now())

  @@unique([userId, publishedMonoId])
  @@index([publishedMonoId])
  @@map("mono_reactions")
}

model CreatorMonoCollection {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @db.Uuid
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  visibility    String   @default("public")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items CreatorMonoCollectionItem[]

  @@index([ownerId, sortOrder, createdAt])
  @@map("creator_mono_collections")
}

model CreatorMonoCollectionItem {
  id              String                @id @default(uuid()) @db.Uuid
  collectionId    String                @db.Uuid
  collection      CreatorMonoCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  publishedMonoId String                @db.Uuid
  publishedMono   PublishedMono         @relation(fields: [publishedMonoId], references: [id], onDelete: Cascade)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())

  /// Product rule (M8f): a published mono can belong to only one creator collection.
  @@unique([publishedMonoId])
  @@index([publishedMonoId])
  @@map("creator_mono_collection_items")
}
