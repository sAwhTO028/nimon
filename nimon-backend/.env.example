# Server
PORT=3000
NODE_ENV=
# Public web origin for share/deep links (e.g. `/mono/<id>`). **Not** the uploads base (`MEDIA_PUBLIC_BASE_URL`).
# Local dev default when unset: http://localhost:3000. For physical device testing on LAN, set to your PC IP, e.g.:
# NIMON_PUBLIC_WEB_BASE_URL=http://192.168.11.5:3000
NIMON_PUBLIC_WEB_BASE_URL=http://localhost:3000
# Optional: comma-free single origin, or * for “reflect / permissive” API behavior.
# Static /uploads uses this for Access-Control-Allow-Origin; unset = localhost reflect + non-prod * fallback.
CORS_ORIGIN=
# Local dev: optional default user id for seeding; not used as a production default.
DEV_OWNER_ID=
# Local dev only: allow story-drafts/published-monos without Bearer JWT when true.
# Never enable in production. Requires NODE_ENV !== production.
ALLOW_DEV_OWNER_FALLBACK=

# Database (placeholder - Prisma/Postgres later)
DATABASE_URL=

# Redis (placeholder - later)
REDIS_URL=

# Auth (M1a+)
# Production: JWT_SECRET must be >= 32 chars. Development may omit (uses documented fallback — never ship fallback).
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Refresh token lifetime for opaque tokens (seconds). Default in code: 604800 (7 days).
JWT_REFRESH_EXPIRES_IN=

# Media uploads (M5b/M6): driver + local disk + static `/uploads`, or S3-compatible object storage for staging/prod.
# MEDIA_STORAGE_DRIVER: `disk` = local filesystem (default, dev). `s3` or `r2` = AWS S3 or Cloudflare R2 via the same driver.
MEDIA_STORAGE_DRIVER=disk
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/uploads
MEDIA_UPLOAD_DIR=uploads
# Required when MEDIA_STORAGE_DRIVER is s3 or r2:
MEDIA_BUCKET=
MEDIA_REGION=
# Optional custom endpoint (e.g. Cloudflare R2). When set, path-style addressing defaults on unless MEDIA_S3_FORCE_PATH_STYLE overrides.
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Optional key prefix (no leading slash); objects are `prefix/userId/kind/<timestamp>-<uuid>.<ext>`.
MEDIA_OBJECT_KEY_PREFIX=
# Optional: override path-style for virtual-hosted-style custom endpoints (true/false).
MEDIA_S3_FORCE_PATH_STYLE=
MEDIA_COVER_MAX_BYTES=10485760
MEDIA_AUDIO_MAX_BYTES=52428800

