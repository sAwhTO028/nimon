# nimon-backend/.env.example
# Example only. Do not put real secrets here.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
JWT_SECRET="replace-with-strong-32-plus-character-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="2592000"

# Public URLs
NIMON_PUBLIC_WEB_BASE_URL="http://localhost:3000"
PUBLIC_WEB_BASE_URL="http://localhost:3000"

# Media
MEDIA_UPLOAD_DIR="uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000/uploads"

# Optional future object storage
MEDIA_STORAGE_DRIVER="disk"
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_OBJECT_KEY_PREFIX=
MEDIA_S3_FORCE_PATH_STYLE=